{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "ButtonAssign": {
            "additionalProperties": false,
            "description": "ボタンを指定されたキーとして機能させます",
            "properties": {
                "button": {
                    "description": "ボタンを指定されたキーとして機能させます",
                    "maxLength": 1,
                    "minLength": 1,
                    "type": "string"
                },
                "comment": {
                    "type": "string"
                }
            },
            "required": [
                "button"
            ],
            "type": "object"
        },
        "ButtonIdAssign": {
            "additionalProperties": false,
            "description": "ボタンを指定されたキーとして機能させます",
            "properties": {
                "button": {
                    "$ref": "#/definitions/KeyIds",
                    "description": "ボタンを指定されたキーとして機能させます"
                },
                "comment": {
                    "type": "string"
                }
            },
            "required": [
                "button"
            ],
            "type": "object"
        },
        "DelayAction": {
            "additionalProperties": false,
            "description": "指定されたミリ秒だけ、動作を停止します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "delay": {
                    "description": "指定されたミリ秒だけ、動作を停止します",
                    "type": "number"
                }
            },
            "required": [
                "delay"
            ],
            "type": "object"
        },
        "KeyIds": {
            "enum": [
                "BACKSPACE",
                "CAPS_LOCK",
                "DELETE",
                "DOWN_ARROW",
                "END",
                "ESC",
                "F1",
                "F10",
                "F11",
                "F12",
                "F13",
                "F14",
                "F15",
                "F16",
                "F17",
                "F18",
                "F19",
                "F2",
                "F20",
                "F21",
                "F22",
                "F23",
                "F24",
                "F3",
                "F4",
                "F5",
                "F6",
                "F7",
                "F8",
                "F9",
                "HOME",
                "INSERT",
                "KP_0",
                "KP_1",
                "KP_2",
                "KP_3",
                "KP_4",
                "KP_5",
                "KP_6",
                "KP_7",
                "KP_8",
                "KP_9",
                "KP_ASTERISK",
                "KP_DOT",
                "KP_ENTER",
                "KP_MINUS",
                "KP_PLUS",
                "KP_SLASH",
                "LEFT_ALT",
                "LEFT_ARROW",
                "LEFT_CTRL",
                "LEFT_GUI",
                "LEFT_SHIFT",
                "MENU",
                "NUM_LOCK",
                "PAGE_DOWN",
                "PAGE_UP",
                "PAUSE",
                "PRINT_SCREEN",
                "RETURN",
                "RIGHT_ALT",
                "RIGHT_ARROW",
                "RIGHT_CTRL",
                "RIGHT_GUI",
                "RIGHT_SHIFT",
                "SCROLL_LOCK",
                "TAB",
                "UP_ARROW"
            ],
            "type": "string"
        },
        "MacroActions": {
            "anyOf": [
                {
                    "$ref": "#/definitions/TypeAction",
                    "description": "一連の文字列をタイプします"
                },
                {
                    "$ref": "#/definitions/TapAction",
                    "description": "指定されたキーを押して離します"
                },
                {
                    "$ref": "#/definitions/TapIdAction",
                    "description": "指定されたキーを押して離します"
                },
                {
                    "$ref": "#/definitions/PressAction",
                    "description": "指定されたキーを押します"
                },
                {
                    "$ref": "#/definitions/PressIdAction",
                    "description": "指定されたキーを押します"
                },
                {
                    "$ref": "#/definitions/ReleaseAction",
                    "description": "指定されたキーを離します"
                },
                {
                    "$ref": "#/definitions/ReleaseIdAction",
                    "description": "指定されたキーを離します"
                },
                {
                    "$ref": "#/definitions/ReleaseAllAction",
                    "description": "指定されたキーを離します"
                },
                {
                    "$ref": "#/definitions/DelayAction",
                    "description": "指定されたミリ秒だけ、動作を停止します"
                },
                {
                    "$ref": "#/definitions/MouseClickAction",
                    "description": "マウスの指定されたボタンをクリックします"
                },
                {
                    "$ref": "#/definitions/MouseMoveAction",
                    "description": "マウスを指定された量だけ移動します"
                },
                {
                    "type": [
                        "string",
                        "number"
                    ]
                }
            ]
        },
        "MouseButtonIds": {
            "enum": [
                "LEFT",
                "MIDDLE",
                "RIGHT"
            ],
            "type": "string"
        },
        "MouseClickAction": {
            "additionalProperties": false,
            "description": "マウスの指定されたボタンをクリックします",
            "properties": {
                "click": {
                    "$ref": "#/definitions/MouseButtonIds",
                    "description": "マウスの指定されたボタンをクリックします"
                },
                "comment": {
                    "type": "string"
                }
            },
            "required": [
                "click"
            ],
            "type": "object"
        },
        "MouseMoveAction": {
            "additionalProperties": false,
            "description": "マウスを指定された量だけ移動します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "move": {
                    "additionalProperties": false,
                    "description": "マウスを指定された量だけ移動します",
                    "properties": {
                        "x": {
                            "type": "number"
                        },
                        "y": {
                            "type": "number"
                        }
                    },
                    "required": [
                        "x",
                        "y"
                    ],
                    "type": "object"
                }
            },
            "required": [
                "move"
            ],
            "type": "object"
        },
        "PressAction": {
            "additionalProperties": false,
            "description": "指定されたキーを押します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "press": {
                    "description": "指定されたキーを押します",
                    "maxLength": 1,
                    "minLength": 1,
                    "type": "string"
                }
            },
            "required": [
                "press"
            ],
            "type": "object"
        },
        "PressIdAction": {
            "additionalProperties": false,
            "description": "指定されたキーを押します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "press": {
                    "$ref": "#/definitions/KeyIds",
                    "description": "指定されたキーを押します"
                }
            },
            "required": [
                "press"
            ],
            "type": "object"
        },
        "ReleaseAction": {
            "additionalProperties": false,
            "description": "指定されたキーを離します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "release": {
                    "description": "指定されたキーを離します",
                    "maxLength": 1,
                    "minLength": 1,
                    "type": "string"
                }
            },
            "required": [
                "release"
            ],
            "type": "object"
        },
        "ReleaseAllAction": {
            "additionalProperties": false,
            "description": "指定されたキーを離します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "release": {
                    "const": "ALL",
                    "description": "指定されたキーを離します",
                    "type": "string"
                }
            },
            "required": [
                "release"
            ],
            "type": "object"
        },
        "ReleaseIdAction": {
            "additionalProperties": false,
            "description": "指定されたキーを離します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "release": {
                    "$ref": "#/definitions/KeyIds",
                    "description": "指定されたキーを離します"
                }
            },
            "required": [
                "release"
            ],
            "type": "object"
        },
        "SlotCommand": {
            "anyOf": [
                {
                    "$ref": "#/definitions/TypeAction",
                    "description": "一連の文字列をタイプします"
                },
                {
                    "$ref": "#/definitions/MouseClickAction",
                    "description": "マウスの指定されたボタンをクリックします"
                },
                {
                    "$ref": "#/definitions/ButtonAssign",
                    "description": "ボタンを指定されたキーとして機能させます"
                },
                {
                    "$ref": "#/definitions/ButtonIdAssign",
                    "description": "ボタンを指定されたキーとして機能させます"
                },
                {
                    "additionalProperties": false,
                    "properties": {
                        "actions": {
                            "description": "マクロの内容を定義します",
                            "items": {
                                "$ref": "#/definitions/MacroActions"
                            },
                            "type": "array"
                        },
                        "description": {
                            "description": "マクロの用途を記述します",
                            "type": "string"
                        },
                        "name": {
                            "description": "マクロの名称を記述します",
                            "type": "string"
                        }
                    },
                    "required": [
                        "actions",
                        "name"
                    ],
                    "type": "object"
                },
                {
                    "items": {
                        "$ref": "#/definitions/MacroActions"
                    },
                    "type": "array"
                },
                {
                    "type": "string"
                }
            ]
        },
        "TapAction": {
            "additionalProperties": false,
            "description": "指定されたキーを押して離します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "tap": {
                    "description": "指定されたキーを押して離します",
                    "maxLength": 1,
                    "minLength": 1,
                    "type": "string"
                }
            },
            "required": [
                "tap"
            ],
            "type": "object"
        },
        "TapIdAction": {
            "additionalProperties": false,
            "description": "指定されたキーを押して離します",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "tap": {
                    "$ref": "#/definitions/KeyIds",
                    "description": "指定されたキーを押して離します"
                }
            },
            "required": [
                "tap"
            ],
            "type": "object"
        },
        "TypeAction": {
            "additionalProperties": false,
            "description": "一連の文字列をタイプします",
            "properties": {
                "comment": {
                    "type": "string"
                },
                "type": {
                    "description": "一連の文字列をタイプします",
                    "type": "string"
                }
            },
            "required": [
                "type"
            ],
            "type": "object"
        }
    },
    "items": {
        "$ref": "#/definitions/SlotCommand"
    },
    "type": "array"
}

